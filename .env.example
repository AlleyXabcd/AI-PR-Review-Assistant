# ===== AI PR Review Assistant 环境变量示例 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# ---- DeepSeek（LLM 提供方，OpenAI 兼容接口）----
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 主力模型（DeepSeek-V3）：负责变更总结与全量 hunk 分诊
DEEPSEEK_CHAT_MODEL=deepseek-chat
# 推理模型（DeepSeek-R1）：负责高风险点深度复查
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---- GitHub（拉取 PR 变更，使用 Personal Access Token）----
# 在 https://github.com/settings/tokens 创建，需 repo 读权限
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 后端服务 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- 前端访问后端的地址 ----
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
